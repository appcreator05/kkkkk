<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <uses-sdk
        tools:overrideLibrary="androidx.core.ktx,androidx.core,androidx.activity,androidx.activity.ktx,androidx.fragment,androidx.fragment.ktx,androidx.lifecycle,androidx.lifecycle.common,androidx.lifecycle.runtime,androidx.lifecycle.runtime.ktx,androidx.lifecycle.viewmodel,androidx.lifecycle.viewmodel.ktx,androidx.lifecycle.viewmodel.savedstate,androidx.lifecycle.livedata,androidx.lifecycle.livedata.core,androidx.lifecycle.livedata.core.ktx,androidx.lifecycle.process,androidx.savedstate,androidx.savedstate.ktx,androidx.collection,androidx.collection.ktx,androidx.startup,androidx.tracing,androidx.profileinstaller,androidx.annotation.experimental,androidx.privacysandbox.ads.adservices,androidx.privacysandbox.ads.adservices.java,androidx.customview,androidx.customview.poolingcontainer,androidx.drawerlayout,androidx.vectordrawable,androidx.vectordrawable.animated,androidx.interpolator,androidx.cursoradapter,androidx.browser,androidx.webkit,androidx.appcompat,androidx.appcompat.resources,androidx.multidex,androidx.concurrent.futures,com.google.android.material,com.google.android.gms.base,com.google.android.gms.basement,com.google.android.gms.tasks,com.google.android.gms.common,com.google.android.gms.ads,com.google.android.gms.ads.impl,com.google.android.gms.ads.lite,com.google.android.gms.ads.base,com.google.android.gms.ads.identifier,com.google.android.gms.ads_identifier,com.google.android.gms.appset,com.google.android.gms.measurement.base,com.google.android.gms.measurement.sdk,com.google.android.datatransport,com.google.android.datatransport.backend.cct,com.google.android.datatransport.runtime,com.google.firebase,com.google.firebase.ktx,com.google.firebase.common,com.google.firebase.common.ktx,com.google.firebase.database,com.google.firebase.database.ktx,com.google.firebase.database.collection,com.google.firebase.components,com.google.firebase.concurrent,com.google.firebase.tracing,com.google.firebase.installations,com.google.firebase.installations.interop,com.google.firebase.appcheck.interop,com.google.firebase.auth.interop,com.google.firebase.encoders,com.google.firebase.encoders.json,com.google.firebase.encoders.proto,kotlinx.coroutines,kotlinx.coroutines.android" />

    <application
        android:name="androidx.multidex.MultiDexApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HDSKay"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <!-- Google Mobile Ads (AdMob) App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3440654346799700~9005154179" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep linking: movieapp:// -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="movieapp" />
            </intent-filter>

            <!-- Deep linking: https://hdskay.blogspot.com -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="hdskay.blogspot.com" />
            </intent-filter>
        </activity>
    </application>

</manifest>
